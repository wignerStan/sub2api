module(
    name = "sub2api",
    version = "0.1.178",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
# Bazel 9 removed the CcInfo builtin; rules_go < 0.59 fails analysis.
bazel_dep(name = "rules_go", version = "0.59.0")
# rustc/cargo binaries only. cargo test uses the worker's gcc for aws-lc-rs.
# hermetic_cc 3.2.0 breaks Bazel 9 (`provides` NoneType). 4.3.0 is required
# so rules_rust can resolve @@bazel_tools//tools/cpp:toolchain_type on Linux.
bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

# Hermetic Go SDK (linux/amd64 on the GHA-like RBE worker). The worker
# image does not need a system go — it only executes this toolchain.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")

go_sdk.from_file(
    name = "go_sdk",
    go_mod = "//backend:go.mod",
)

use_repo(go_sdk, "go_sdk")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")

rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "x86_64-unknown-linux-gnu",
    ],
)

use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

zig = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")

zig.exec_platform(
    os = "linux",
    arch = "amd64",
)

use_repo(zig, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain/linux-amd64:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
)

