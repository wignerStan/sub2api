package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(
        [
            "Cargo.toml",
            "Cargo.lock",
            "src/**",
        ],
        allow_empty = True,
    ) + [
        "//rustsidecar/vendor/http-client:srcs",
        "//rustsidecar/vendor/websocket-client:srcs",
        "//rustsidecar/vendor/utils-rustls-provider:srcs",
    ],
)
